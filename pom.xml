<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.0</version>
		<relativePath/>
	</parent>
	<groupId>com.example</groupId>
	<artifactId>archive-poc</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>archive-poc</name>
	<description>Spring pg_partman S3 archive PoC</description>

	<properties>
		<java.version>25</java.version>
		<awssdk.version>2.30.31</awssdk.version>
		<!-- aws-crt is in a separate group (software.amazon.awssdk.crt) and is NOT
		     managed by the awssdk BOM. 0.34.1 is the version awssdk 2.30.31's parent
		     pom pins internally — keeping them aligned avoids ABI mismatches at runtime. -->
		<awscrt.version>0.34.1</awscrt.version>
		<testcontainers.version>1.21.4</testcontainers.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${awssdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>
		<!-- High-level streaming uploader. Built on the CRT-based S3AsyncClient,
		     which uploads multipart in parallel and accepts unknown content lengths —
		     the streaming COPY → gzip → S3 pipeline depends on both properties. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3-transfer-manager</artifactId>
		</dependency>
		<!-- Native AWS Common Runtime binding. s3-transfer-manager declares this
		     as optional, so it must be added explicitly. Pulls in platform-specific
		     native libraries — incompatible with Alpine/musl base images. -->
		<dependency>
			<groupId>software.amazon.awssdk.crt</groupId>
			<artifactId>aws-crt</artifactId>
			<version>${awscrt.version}</version>
		</dependency>

		<!-- Programmatic RetryTemplate around the S3 upload step. We do NOT pull in
		     spring-aspects: @Retryable lives at method boundaries, but our retry-able
		     unit is a single statement inside runOnce(), so we wire it in code. -->
		<dependency>
			<groupId>org.springframework.retry</groupId>
			<artifactId>spring-retry</artifactId>
		</dependency>

		<!-- Parquet output (opt-in via archive.format=parquet). We write through
		     LocalOutputFile from parquet-common (since 1.14, PARQUET-2449), avoiding
		     Hadoop's filesystem abstractions entirely at runtime. -->
		<dependency>
			<groupId>org.apache.parquet</groupId>
			<artifactId>parquet-avro</artifactId>
			<version>1.15.0</version>
		</dependency>
		<!-- Compile-only: AvroParquetWriter#builder(...) is overloaded to accept
		     org.apache.hadoop.fs.Path, so javac needs the class visible to resolve
		     method candidates even though we never call that overload. provided +
		     optional keeps hadoop-common out of the runtime fat jar; spring-boot-
		     maven-plugin honours both flags when repackaging. -->
		<dependency>
			<groupId>org.apache.hadoop</groupId>
			<artifactId>hadoop-common</artifactId>
			<version>3.5.0</version>
			<scope>provided</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>localstack</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- hadoop-common is declared above as compile-only (it's needed for
					     javac to resolve AvroParquetWriter#builder overloads). At runtime
					     ParquetS3Archiver uses LocalOutputFile from parquet-common and
					     never touches Hadoop's filesystem code. Strip the entire hadoop-*
					     family from the runnable jar to avoid shipping ~10 MB of unused
					     classes plus jersey/kerby/woodstox transitives that would come
					     with hadoop-common at compile/runtime scope. -->
					<excludeGroupIds>org.apache.hadoop,org.apache.hadoop.thirdparty</excludeGroupIds>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Same UTC pinning as the production main() so partition bounds
					     computed by pg_partman during Flyway migrations align on UTC. -->
					<argLine>-Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
